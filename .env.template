# ========================================================
# JARVIS 2.0 - PRODUCTION ENVIRONMENT VARIABLES
# ========================================================
# Copy this file to .env and fill in your REAL credentials
# NO MOCK DATA - Production authentication only

# CORE AGENT IDENTITY (REQUIRED)
AGENT_NAME=Your Full Name
AGENT_EMAIL=your.email@example.com
AGENT_PHONE=+1-555-123-4567

# DOCUMENT PATHS (REQUIRED - Must be real files)
RESUME_PATH=C:\path\to\your\resume.pdf
COVER_LETTER_PATH=C:\path\to\your\cover_letter.pdf

# JOB SEARCH CRITERIA (OPTIONAL - Override config file)
JOB_KEYWORDS=process engineer,manufacturing engineer,operations analyst
INDUSTRIES=Manufacturing,Technology,Aerospace
LOCATION=Portland OR,Remote,United States
INTERNATIONAL_SEARCH=false

# AUTOMATION SETTINGS (OPTIONAL)
MAX_APPLICATIONS=50
RATE_LIMIT=10

# LINKEDIN CREDENTIALS (REQUIRED for LinkedIn applications)
LINKEDIN_EMAIL=your.linkedin@email.com
LINKEDIN_PASSWORD=your_linkedin_password

# INDEED CREDENTIALS (REQUIRED for Indeed applications)
INDEED_EMAIL=your.indeed@email.com
INDEED_PASSWORD=your_indeed_password

# GLASSDOOR CREDENTIALS (OPTIONAL)
GLASSDOOR_EMAIL=your.glassdoor@email.com
GLASSDOOR_PASSWORD=your_glassdoor_password

# MONSTER CREDENTIALS (OPTIONAL)
MONSTER_EMAIL=your.monster@email.com
MONSTER_PASSWORD=your_monster_password

# ZIPRECRUITER CREDENTIALS (OPTIONAL)
ZIPRECRUITER_EMAIL=your.ziprecruiter@email.com
ZIPRECRUITER_PASSWORD=your_ziprecruiter_password

# COMPANY-SPECIFIC CREDENTIALS (OPTIONAL)
NIKE_EMAIL=your.nike@email.com
NIKE_PASSWORD=your_nike_password

INTEL_EMAIL=your.intel@email.com
INTEL_PASSWORD=your_intel_password

ADIDAS_EMAIL=your.adidas@email.com
ADIDAS_PASSWORD=your_adidas_password

# BROWSER AUTOMATION SETTINGS
BROWSER_VISIBLE=true
BROWSER_SINGLE_WINDOW=true
BROWSER_RATE_LIMIT_MS=3000
BROWSER_TIMEOUT_SECONDS=30

# PRODUCTION SAFETY SETTINGS
VALIDATE_URLS=true
REJECT_MOCK_DATA=true
REQUIRE_REAL_FILES=true
ENABLE_MANUAL_INTERVENTION=true

# LOGGING AND MONITORING
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
REAL_TIME_MONITORING=true

# WEB SERVER (OPTIONAL - for API access)
WEB_SERVER_PORT=8080
WEB_SERVER_ENABLED=false
API_ACCESS_TOKEN=secure_random_token_here
